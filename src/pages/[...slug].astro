---
import { getCollection, render } from 'astro:content';
import DocsLayout from '@/layouts/DocsLayout.astro';
import { getNav } from '@/lib/nav';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const nav = await getNav();
const section =
  nav.find((s) => s.items.some((item) => item.href === `/${entry.id}`))?.label ??
  (entry.data.section === 'start' ? 'Getting Started' : 'Reference');
---

<DocsLayout title={entry.data.title} description={entry.data.description} section={section} headings={headings}>
  <Content />
</DocsLayout>
