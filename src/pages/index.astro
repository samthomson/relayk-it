---
import BaseLayout from '@/layouts/BaseLayout.astro';
import NostrEventsBackground from '@/components/NostrEventsBackground.astro';
import Icon from '@/components/Icon.astro';
import ArchDiagram from '@/components/ArchDiagram.astro';
import { brandAccent } from '@/lib/brandAccents';
type StyleRecord = Record<string, string>;

const GITHUB_URL = 'https://github.com/samthomson/relaykit';

/** Preset cycle from RubixLoaderColor — the five service brand hues. */
const CUBE_COLORS = '#A78BFA,#FBBF24,#F87171,#E879F9,#52525B';

const rkStyle = (index: number): StyleRecord => ({
  '--rk-card-base': brandAccent(index).base,
  '--rk-card-glow': brandAccent(index).glow,
});

const rkTileStyle = (index: number): StyleRecord => ({
  borderColor: brandAccent(index).base,
  '--rk-icon-glow': brandAccent(index).glow,
});

const features = [
  {
    icon: 'rocket',
    title: 'One-command install',
    body: 'A single script provisions the whole stack on any VPS',
  },
  {
    icon: 'box',
    title: 'Run NOSTR services',
    body: 'Any mix of relays, Blossom, git, nsites, notifications — as many of each as you want, nothing you didn\u2019t ask for',
  },
  {
    icon: 'globe',
    title: 'Use your own domains',
    body: 'Link any service to a domain you already own; routing and SSL handled for you',
  },
  {
    icon: 'layers',
    title: 'Projects & environments',
    body: 'Organise services by project or environment',
  },
  {
    icon: 'key',
    title: 'NIP-07 sign-in',
    body: 'Your Nostr identity is the login — no passwords, no user management. Use your existing Nostr browser extension.',
  },
  {
    icon: 'refresh-cw',
    title: 'One-click updates',
    body: 'Pull the latest version from the dashboard when you choose — services keep running. 100% uptime.',
  },
] as const;

const audiences = [
  {
    icon: 'users',
    title: 'Self-hosters',
    body: 'Run your own relay, Blossom server, or nsite gateway without complex configuration.',
  },
  {
    icon: 'wrench',
    title: 'Developers',
    body: 'Spin up disposable test infrastructure for dev environments in seconds. Finally a nostr testnet.',
  },
] as const;

const services = [
  {
    icon: 'server',
    accent: 2,
    title: 'Relays',
    body: 'Choose from three relay engines, each suited to a different job',
    href: '/services/strfry',
    linkLabel: 'strfry · nostr-rs-relay · chapar',
    code: 'wss://relay.yourdomain.com',
  },
  {
    icon: 'image',
    accent: 3,
    title: 'Blossom',
    body: 'Media server for images, videos, and files',
    href: '/services/blossom',
    linkLabel: 'blossom server',
    code: 'https://blossom.yourdomain.com',
  },
  {
    icon: 'globe',
    accent: 4,
    title: 'nPanel',
    body: 'nsite gateway (NIP-5A) with built-in NIP-05 names on the same domain. Auto-republishes whenever you update your nsite, from anywhere.',
    href: '/services/npanel',
    linkLabel: 'nsite gateway',
    code: 'https://yourdomain.com',
  },
  {
    icon: 'git-branch',
    accent: 5,
    title: 'grasp',
    body: 'Self-hosted git-over-nostr backend. Git host with an embedded relay (GRASP), plus a built-in ngit repo explorer.',
    href: '/services/grasp',
    linkLabel: 'git over nostr',
    code: 'https://git.yourdomain.com',
  },
  {
    icon: 'bell',
    accent: 6,
    title: 'pulse',
    body: 'Nostr notifications. Mentions, replies, zaps and DMs pushed to your phone — no Play Services, happy on GrapheneOS.',
    href: '/services/pulse',
    linkLabel: 'push notifications',
  },
] as const;

const apps = [
  {
    title: 'Hello World',
    body: 'Scheduled Nostr posting — write now, publish later, to your own relays or any',
    href: '/apps/hello-world',
    icon: 'calendar-clock',
  },
  {
    title: 'Relay explorer',
    body: 'Live visibility into any Nostr relay — watch events, filters and kinds land in real time',
    href: '/apps/relay-explorer',
    icon: 'server',
  },
  {
    title: 'Blossom explorer',
    body: 'Browse and verify stored blobs — by hash, pubkey or type',
    href: '/apps/blossom-explorer',
    icon: 'image',
  },
  {
    title: 'nPanel',
    body: 'Host nsites as normal websites on your own domain — with inspection and debugging built in',
    href: '/apps/npanel',
    icon: 'globe',
  },
  {
    title: 'grasp explorer',
    body: 'The front page for your git host — repos, branches and history, clone URLs ready',
    href: '/apps/grasp-explorer',
    icon: 'git-branch',
  },
] as const;

---

<BaseLayout
  title="RelayKit — Run your own Nostr stack"
  description="Stop renting your Nostr existence. One command turns any server into your home: relays, Blossom, nsites, git, notifications — on your own domains."
  bareTitle={true}
>
  <NostrEventsBackground />

  <!-- Hero -->
  <section class="relative isolate px-6 pt-16 pb-20 sm:pt-28 sm:pb-28 md:pt-32 md:pb-32">
    <div class="relative z-10 text-center">
      <div class="mb-10 flex justify-center">
        <canvas
          data-rubix-cube
          data-size="320"
          data-colors={CUBE_COLORS}
          class="h-[320px] w-[320px] max-w-full"
          aria-label="Rotating Rubik's cube — the RelayKit emblem"
          role="img"></canvas>
      </div>
      <div class="mb-10 flex min-h-[8rem] w-full items-center justify-center px-4 sm:min-h-[10rem] lg:min-h-[12rem]">
        <div
          class="rk-wordmark title-cursor-container font-display text-5xl font-bold uppercase leading-none tracking-[0.2em] text-foreground sm:text-7xl md:text-8xl lg:text-9xl"
          data-typewriter-container
          data-hidden
        >
          <span data-typewriter data-text="RELAYKIT"></span>
          <span class="cursor-bar animate-blink bg-[rgb(118,82,168)] shadow-[0_0_14px_rgba(90,60,140,0.65)] sm:w-3"></span>
        </div>
      </div>
      <p class="mx-auto mb-10 max-w-2xl text-xl leading-relaxed text-muted-foreground">
        Stop renting your Nostr existence. One command turns any server into your home: relays, Blossom,
        nsites, git, notifications — on your own domains.
      </p>
      <div class="mb-8 flex flex-col justify-center gap-4 sm:flex-row">
        <a
          href="/install"
          class="inline-flex items-center justify-center bg-accent px-8 text-base text-accent-foreground transition-shadow ring-1 ring-transparent hover:bg-accent/90 hover:ring-[rgba(118,82,168,0.85)] hover:shadow-[0_0_32px_-4px_rgba(90,60,140,0.55)] py-3 font-semibold"
        >
          Get started
          <Icon name="arrow-right" class="ml-2 h-4 w-4" />
        </a>
        <a
          href={GITHUB_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center border border-border px-8 py-3 text-base font-semibold text-foreground transition-colors hover:border-[rgb(118,82,168)] hover:text-[rgb(118,82,168)]"
        >
          View on GitHub
          <Icon name="arrow-right" class="ml-2 h-4 w-4" />
        </a>
      </div>
      <div class="flex justify-center">
        <a
          href="https://github.com/samthomson/relaykit/issues"
          target="_blank"
          rel="noopener noreferrer"
          class="border-2 border-[rgb(118,82,168)] px-6 py-3 text-sm font-bold uppercase tracking-wider text-foreground shadow-[0_0_28px_-6px_rgba(90,60,140,0.45)] transition-shadow hover:shadow-[0_0_36px_-4px_rgba(90,60,140,0.7)] hover:ring-1 hover:ring-[rgba(118,82,168,0.85)]"
        >
          Currently in Beta — Contributions Welcome
        </a>
      </div>
    </div>
  </section>

  <!-- Why it exists -->
  <section class="relative isolate border-t border-border px-6 py-20">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="mb-10 text-3xl font-bold text-foreground">
        <span class="rk-section-title inline-block">Why</span>
      </h2>
      <p class="text-lg leading-relaxed text-muted-foreground">
        The Nostr network is only as free as the infrastructure underneath it. When your notes live on
        other people&rsquo;s relays and your media on other people&rsquo;s servers, your Nostr experience is
        borrowed. RelayKit exists to make owning it trivial — your server, your domains, your data.
        Sovereignty as <s class="text-muted-foreground/70">a</s> <strong class="font-bold text-foreground">your</strong> service.
      </p>
    </div>
  </section>

  <!-- Architecture diagram -->
  <section class="border-t border-border px-6 py-20">
    <div class="mx-auto max-w-5xl">
      <h2 class="mb-4 text-center text-3xl font-bold text-foreground">
        <span class="rk-section-title inline-block">One server, the whole stack</span>
      </h2>
      <p class="mx-auto mb-12 max-w-2xl text-center text-lg leading-relaxed text-muted-foreground">
        Run whatever mix you want — one relay or five, media, git, sites, notifications — and skip
        the rest. Clients reach them from anywhere, over open protocols.
      </p>
      <ArchDiagram />
    </div>
  </section>

  <!-- One script -->
  <section class="border-t border-border px-6 py-20">
    <div class="mx-auto max-w-2xl">
      <div class="border border-border bg-[rgb(24,24,30)] p-5 text-sm leading-7 text-[rgb(226,226,236)] dark:bg-[hsl(270,7%,11%)] dark:text-[rgb(230,226,238)]">
        <div><span class="text-[rgb(196,181,253)]">$</span> git clone https://github.com/samthomson/relaykit</div>
        <div><span class="text-[rgb(196,181,253)]">$</span> cd relaykit && ./scripts/install.sh</div>
        <div><span class="text-[rgb(196,181,253)]">$</span> <span class="animate-blink text-[rgb(196,181,253)]">&#9612;</span></div>
      </div>
      <p class="mt-4 text-center text-sm leading-relaxed text-muted-foreground">
        Any VPS works — Vultr, DigitalOcean, Hetzner, even one you pay for in bitcoin. Point your DNS
        at it, run the script, sign in with your Nostr key.
      </p>
    </div>
  </section>

  <!-- What's in the kit -->
  <section class="border-t border-border px-6 py-20">
    <div class="container mx-auto">
      <h2 class="mb-16 text-center text-3xl font-bold text-foreground">
        <span class="rk-section-title inline-block">What&rsquo;s in the kit</span>
      </h2>
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        {
          features.map((f, i) => (
            <div class="space-y-4 text-center">
              <div
                class="rk-icon-tile mx-auto flex h-12 w-12 items-center justify-center border bg-background/60"
                style={rkTileStyle(i)}
              >
                <Icon name={f.icon} class="h-6 w-6" style={`color: ${brandAccent(i).base}`} />
              </div>
              <h3 class="font-semibold text-foreground">{f.title}</h3>
              <p class="text-sm text-muted-foreground">{f.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Who it's for -->
  <section class="px-6 py-20">
    <div class="mx-auto max-w-5xl">
      <h2 class="mb-16 text-center text-3xl font-bold text-foreground">
        <span class="rk-section-title inline-block">Who it&rsquo;s for</span>
      </h2>
      <div class="grid gap-8 md:grid-cols-2">
        {
          audiences.map((a, i) => (
            <div class="rk-card-hover border border-border bg-card/80 px-6 pb-6 pt-8" style={rkStyle(i)}>
              <div
                class="rk-icon-tile flex h-10 w-10 items-center justify-center border bg-background/50"
                style={rkTileStyle(i)}
              >
                <Icon name={a.icon} class="h-5 w-5" style={`color: ${brandAccent(i).base}`} />
              </div>
              <h3 class="mt-4 text-lg font-semibold text-foreground">{a.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{a.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- What you can deploy -->
  <section class="border-t border-border px-6 py-20">
    <div class="container mx-auto">
      <h2 class="mb-16 text-center text-3xl font-bold text-foreground">
        <span class="rk-section-title inline-block">What you can deploy</span>
      </h2>
      <p class="mx-auto -mt-10 mb-12 max-w-2xl text-center text-base leading-relaxed text-muted-foreground">
        Pick and mix — every service is independent and optional. RelayKit is not a monolith: it stays
        exactly as light as the choices you make.
      </p>
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {
          services.map((s) => (
            <a href={s.href} class="rk-card-hover block border border-border bg-card/80 px-6 pb-6 pt-8" style={rkStyle(s.accent)}>
              <div
                class="rk-icon-tile flex h-10 w-10 items-center justify-center border bg-background/50"
                style={rkTileStyle(s.accent)}
              >
                <Icon name={s.icon} class="h-5 w-5" style={`color: ${brandAccent(s.accent).base}`} />
              </div>
              <h3 class="mt-4 text-lg font-semibold text-foreground">{s.title}</h3>
              <p class="mt-2 mb-3 text-sm leading-relaxed text-muted-foreground">{s.body}</p>
              {'code' in s && s.code && (
                <code class="block break-all text-[10px] text-[rgb(72,48,118)] dark:text-[rgba(190,165,235,0.95)]">
                  {s.code}
                </code>
              )}
              <div class="mt-3 inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wider text-muted-foreground group-hover:text-[rgb(118,82,168)]">
                {s.linkLabel}
                <Icon name="arrow-right" class="h-3 w-3" />
              </div>
            </a>
          ))
        }
      </div>
      <div class="mt-10 text-center">
        <a
          href="/services"
          class="rk-link inline-flex items-center gap-2 border-b-2 border-[rgba(118,82,168,0.4)] pb-1 text-sm"
        >
          Compare all services
          <Icon name="arrow-right" class="h-3.5 w-3.5" />
        </a>
      </div>
    </div>
  </section>

  <!-- Bundled apps -->
  <section class="border-t border-border px-6 py-20">
    <div class="mx-auto max-w-4xl">
      <h2 class="mb-16 text-center text-3xl font-bold text-foreground">
        <span class="rk-section-title inline-block">Comes with apps</span>
      </h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          apps.map((a, i) => (
            <a
              href={a.href}
              class="rk-card-hover block border border-border bg-card/80 px-5 pb-5 pt-6"
              style={{ '--rk-card-base': brandAccent(i).base, '--rk-card-glow': brandAccent(i).glow }}
            >
              <div
                class="rk-icon-tile flex h-9 w-9 items-center justify-center border bg-background/50"
                style={{ borderColor: brandAccent(i).base, '--rk-icon-glow': brandAccent(i).glow }}
              >
                <Icon name={a.icon} class="h-4.5 w-4.5 h-[18px] w-[18px]" style={`color: ${brandAccent(i).base}`} />
              </div>
              <h3 class="mt-3 text-base font-semibold text-foreground">{a.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{a.body}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>


  <!-- Final CTA -->
  <section class="relative isolate border-t border-border px-6 py-24 sm:py-32">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="mb-8 text-4xl font-bold text-foreground">Run your own Nostr stack.</h2>
      <div class="flex flex-col justify-center gap-4 sm:flex-row">
        <a
          href="/install"
          class="inline-flex items-center justify-center bg-accent px-8 py-3 text-base font-semibold text-accent-foreground transition-shadow ring-1 ring-transparent hover:bg-accent/90 hover:ring-[rgba(118,82,168,0.85)] hover:shadow-[0_0_32px_-4px_rgba(90,60,140,0.55)]"
        >
          Get started
          <Icon name="arrow-right" class="ml-2 h-4 w-4" />
        </a>
        <a
          href={GITHUB_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center border border-border px-8 py-3 text-base font-semibold text-foreground transition-colors hover:border-[rgb(118,82,168)] hover:text-[rgb(118,82,168)]"
        >
          View on GitHub
          <Icon name="arrow-right" class="ml-2 h-4 w-4" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
<script src="@/scripts/home.ts"></script>

