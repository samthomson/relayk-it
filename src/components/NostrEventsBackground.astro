---
/**
 * Live-looking Nostr event texture behind the hero — ported from the React
 * original. Mock events (generated at build time) rendered as raw JSON dumps,
 * four columns drifting at different speeds via CSS.
 */

interface MockEvent {
  id: string;
  pubkey: string;
  created_at: number;
  kind: number;
  tags: string[][];
  content: string;
  sig: string;
}

const KINDS = [1, 3, 6, 7, 30023, 30078, 10002];
const CONTENTS = [
  'Setting up my relay with RelayKit',
  'Just deployed a Blossom server',
  'Testing my nsite gateway',
  'Self-hosting is freedom',
  'Finally got my own infrastructure',
  'Running nostr-rs-relay now',
  'Strfry is blazing fast',
];

function randomId(length: number): string {
  return Math.random().toString(36).substring(2, 15).repeat(4).substring(0, length);
}

function generateMockEvents(count: number): MockEvent[] {
  return Array.from({ length: count }, () => ({
    id: randomId(64),
    pubkey: randomId(64),
    created_at: Math.floor(Date.now() / 1000) - Math.floor(Math.random() * 86400),
    kind: KINDS[Math.floor(Math.random() * KINDS.length)],
    tags: [
      ['e', randomId(16)],
      ['p', randomId(16)],
    ],
    content: CONTENTS[Math.floor(Math.random() * CONTENTS.length)],
    sig: randomId(128),
  }));
}

const columns = [
  { events: [...generateMockEvents(8), ...generateMockEvents(8)], duration: '80s', delay: '-10s', direction: 'normal' },
  { events: [...generateMockEvents(8), ...generateMockEvents(8)], duration: '95s', delay: '-45s', direction: 'reverse' },
  { events: [...generateMockEvents(8), ...generateMockEvents(8)], duration: '70s', delay: '-25s', direction: 'normal' },
  { events: [...generateMockEvents(8), ...generateMockEvents(8)], duration: '88s', delay: '-60s', direction: 'reverse' },
];
---

<div class="rk-events-bg opacity-[0.12] text-[hsl(265,48%,38%)] dark:text-[hsl(260,45%,70%)]" aria-hidden="true">
  <div class="absolute inset-0 flex gap-12 px-8">
    {
      columns.map((col) => (
        <div
          class="rk-events-col space-y-8"
          style={`animation-duration: ${col.duration}; animation-delay: ${col.delay}; animation-direction: ${col.direction};`}
        >
          {col.events.map((event) => <pre set:html={JSON.stringify(event, null, 2)} />)}
        </div>
      ))
    }
  </div>
</div>
