# nsite publishing — persistent signing is configured OUTSIDE .env (one-time):
#   .tools/nsyte-0.28.0/nsyte bunker connect 'bunker://…'
#   .tools/nsyte-0.28.0/nsyte bunker use npub1…
# Only set NSITE_BUNKER for a one-shot pairing (secret works for ONE deploy).
# NSITE_BUNKER='bunker://…'

# Plausible Analytics — leave empty to disable tracking entirely.
PLAUSIBLE_DOMAIN="relayk.it"
